# Copiar a .env (chmod 600). NUNCA subir .env al repositorio ni mandarlo por chat.

# CoinMarketCap (plan gratuito alcanza): https://pro.coinmarketcap.com/signup
CMC_API_KEY=

# Telegram: crear bot con @BotFather; el chat_id se obtiene con:  docker compose exec cascada python -m cascada.cli telegram-chat
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Web (usuario y clave para entrar). instalar.sh genera una clave al azar si está vacía.
WEB_USUARIO=admin
WEB_CLAVE=
# Dominio para HTTPS automático. instalar.sh pone <ip-con-guiones>.sslip.io si está vacío.
DOMINIO=

# KuCoin cuenta principal (futuros USDT-M). Sólo para modo real.
# Permisos: General + Futuros (trading). SIN retiros. Restringida a la IP del servidor.
KUCOIN_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

# KuCoin subcuenta de 30 balas (futuro inverso XBTUSDM). Mismas reglas: sin retiros, con IP.
KUCOIN_BALAS_KEY=
KUCOIN_BALAS_SECRET=
KUCOIN_BALAS_PASSPHRASE=
