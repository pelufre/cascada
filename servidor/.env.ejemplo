# Copiar a .env (chmod 600). NUNCA subir .env al repositorio ni mandarlo por chat.

# CoinMarketCap (plan gratuito alcanza) para el top 50 semanal
CMC_API_KEY=

# Telegram: bot de @BotFather; el chat_id sale con:  docker compose exec sistema3 python -m sistema3.cli telegram-chat
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Web (usuario y clave). instalar.sh genera una clave al azar si está vacía.
WEB_USUARIO=admin
WEB_CLAVE=
# Dominio para HTTPS automático. instalar.sh pone <ip-con-guiones>.sslip.io si está vacío.
DOMINIO=

# KuCoin (idealmente una subcuenta sólo para este sistema).
# Permisos: General + Spot + Futuros. SIN retiros. Restringida a la IP del servidor.
KUCOIN_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

# 30 balas 10x (servicio balas10): un bot de Telegram PROPIO para poder confirmar con /si (dos servicios no pueden
# escuchar el mismo bot). Sin esto, balas10 avisa por el bot del Sistema 3 y se confirma con la línea de comandos.
TELEGRAM_TOKEN_BALAS=
# Opcional: otro chat para 30 balas (si está vacío usa TELEGRAM_CHAT_ID)
TELEGRAM_CHAT_ID_BALAS=
